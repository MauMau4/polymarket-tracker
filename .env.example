APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/polymarket
REDIS_URL=redis://localhost:6379/0

POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_DATA_API_BASE_URL=https://data-api.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# CLOB API credentials (obtain from polymarket.com account settings)
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_API_SECRET=
POLYMARKET_CLOB_API_PASSPHRASE=
ALCHEMY_POLYGON_HTTP_URL=
ALCHEMY_POLYGON_WS_URL=

DUNE_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard authentication
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

DEFAULT_WHALE_NOTIONAL_USD=10000
DEFAULT_RELATIVE_LIQUIDITY_THRESHOLD=0.05
DEFAULT_ALERT_COOLDOWN_SECONDS=900
DEFAULT_CLUSTER_WINDOW_SECONDS=300
DEFAULT_WATCHLIST_MARKET_LIMIT=100
WALLET_ATTRIBUTION_TIMEOUT_SECONDS=10

ENABLE_ALCHEMY_RECONCILIATION=false
ENABLE_DUNE_BACKFILL=false
ENABLE_CLUSTER_DETECTION=true
